PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=zkcell_db
JWT_SECRET=
CLIENT_URL=http://localhost:5173

# Mode Fulfillment: 'simulation' (dummy lokal) atau 'digiflazz' (API PPOB nyata)
PPOB_MODE=simulation

# Kredensial Digiflazz (didapat dari Dashboard Digiflazz -> Menu Atur Koneksi -> API)
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_DEV_KEY=
DIGIFLAZZ_PROD_KEY=
DIGIFLAZZ_WEBHOOK_SECRET=

# Set 'true' saat testing dengan API Development Digiflazz, 'false' saat live uang asli
DIGIFLAZZ_TESTING=true